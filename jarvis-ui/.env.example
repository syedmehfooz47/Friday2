# Friday UI Environment Configuration
# Copy this file to .env.local and modify as needed

# Backend server URL (FastAPI)
# For local development:
BACKEND_URL=http://localhost:8000

# For production/deployment, change this to your deployed backend URL:
# BACKEND_URL=https://your-backend-domain.com

# WebSocket URL (used by WebSocketProvider directly)
# Note: WebSocket cannot be proxied through Next.js API routes
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
